<?xml version="1.0" encoding="utf-8"?>
<launch>

  <!-- 追加：インタラクティブマーカーを使うかどうか -->
  <arg name="use_marker" default="True" />


  ###########  IK-based Navigation  ###########
  <node pkg="ik_base_nav" type="dragon_ik_base_navigation_node" name="dragon_ik_base_navigation_node" output="screen" ns="dragon" >

    <rosparam file="$(find ik_base_nav)/config/end_effector.yaml" command="load" />
    <param name="control_frequency" value="40.0" />
  </node>


  <!-- <node pkg="rviz" type="rviz" name="rviz" args="-d $(find ik_base_nav)/config/ik_base_nav.rviz" /> -->

  <!-- Launch interactive marker node -->
  <node pkg="differential_kinematics" type="interactive_marker.py" name="interactive_marker" output="screen" if="$(arg use_marker)">
      <param name="frame_id" value="world" />
  </node>


  <arg name="x" default="0.2" />
  <arg name="y" default="0.0" />
  <arg name="z" default="0.2" />
  <arg name="roll" default="0.0" />
  <arg name="pitch" default="0.2" />
  <arg name="yaw" default="3.14" />

  <!-- Launch pose transformer node -->
  <node pkg="differential_kinematics" type="pose_transformer_ik_actionlib.py" name="pose_transformer" output="screen">
      <param name="x" value="$(arg x)" />
      <param name="y" value="$(arg y)" />
      <param name="z" value="$(arg z)" />
      <param name="roll" value="$(arg roll)" />
      <param name="pitch" value="$(arg pitch)" />
      <param name="yaw" value="$(arg yaw)" />
  </node>

  <node pkg="differential_kinematics" type="ef_offset_keyboard.py" name="ef_offset_keyboard" output="screen">
    <!-- pose_transformer の名前空間 -->
    <param name="target_ns" value="/pose_transformer" />
  </node>

</launch>
